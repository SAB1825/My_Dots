{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "data",
    "source": "                   $2.  *\n             $1_..._\n           .'     `.\n          /   .-\"\"  \\\n          |  /       |\n          \\  `.___.' /\n           `-.___.-'\n  $2.                  .\n           $3/\\\n      /\\  /  \\    /\\\n     /  \\/    \\  /  \\\n $1___/    \\     \\/    \\___\n $3~~~~~~~~~~~~~~~~~~~~~~~~\n     $2.    .    .    .",
    "padding": {
      "top": 1,
      "left": 1,
      "right": 4
    },
    "color": {
      "1": "#c4b5fd",
      "2": "#94a3b8",
      "3": "#5eead4"
    }
  },
  "display": {
    "separator": "  ",
    "key": {
      "width": 10
    },
    "color": {
      "keys": "#94a3b8",
      "title": "#c4b5fd",
      "output": "#e2e8f0"
    }
  },
  "modules": [
    "break",
    {
      "type": "title",
      "format": "{#1}{##c4b5fd}{user-name}{##94a3b8} @ {##5eead4}{host-name}{#}"
    },
    {
      "type": "custom",
      "format": "{##94a3b8}\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500{#}"
    },
    {
      "type": "custom",
      "format": "{##5eead4}SYSTEM{#}"
    },
    {
      "type": "os",
      "key": "os"
    },
    {
      "type": "kernel",
      "key": "kernel",
      "format": "{release}"
    },
    {
      "type": "uptime",
      "key": "uptime"
    },
    {
      "type": "memory",
      "key": "memory",
      "format": "{used} / {total}"
    },
    "break",
    {
      "type": "custom",
      "format": "{##c4b5fd}SESSION{#}"
    },
    {
      "type": "wm",
      "key": "desktop",
      "format": "{1}"
    },
    {
      "type": "terminal",
      "key": "terminal",
      "format": "{1}"
    },
    {
      "type": "shell",
      "key": "shell",
      "format": "{1}"
    },
    {
      "type": "custom",
      "format": "{##94a3b8}\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500{#}"
    },
    {
      "type": "custom",
      "format": "{##c4b5fd}\u25cf  {##a5b4fc}\u25cf  {##93c5fd}\u25cf  {##5eead4}\u25cf  {##f9a8d4}\u25cf  {##e2e8f0}\u25cf{#}"
    },
    "break"
  ]
}
