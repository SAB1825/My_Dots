{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "kitty-direct",
    "source": "~/.config/fastfetch/gojo.png",
    "width": 35,
    "height": 16,
    "padding": {
      "top": 1,
      "left": 1,
      "right": 7
    }
  },
  "display": {
    "separator": "  ",
    "key": {
      "width": 12
    },
    "color": {
      "keys": "blue",
      "title": "white",
      "separator": "bright_black"
    }
  },
  "modules": [
    "break",
    "break",
    {
      "type": "title",
      "format": "{user-name-colored}{at-symbol-colored}{host-name-colored}"
    },
    "break",
    {
      "type": "os",
      "key": "  OS",
      "format": "{pretty-name} {arch}"
    },
    {
      "type": "kernel",
      "key": "  Kernel",
      "format": "{release}"
    },
    {
      "type": "uptime",
      "key": "󰥔  Uptime"
    },
    {
      "type": "packages",
      "key": "󰏖  Pkgs",
      "format": "{pacman} pacman · {flatpak-all} flatpak"
    },
    "break",
    {
      "type": "wm",
      "key": "  WM",
      "format": "{pretty-name} · {protocol-name}"
    },
    {
      "type": "shell",
      "key": "  Shell"
    },
    {
      "type": "terminal",
      "key": "  Term"
    },
    "break",
    {
      "type": "cpu",
      "key": "  CPU",
      "format": "{name} · {cores-physical}C/{cores-logical}T"
    },
    {
      "type": "gpu",
      "key": "󰢮  GPU",
      "hideType": "integrated",
      "format": "{name}"
    },
    {
      "type": "memory",
      "key": "  RAM",
      "format": "{used} / {total}"
    },
    {
      "type": "disk",
      "key": "󰋊  Disk",
      "folders": "/",
      "format": "{size-used} / {size-total}"
    },
    {
      "type": "battery",
      "key": "󰁹  Battery",
      "format": "{capacity} · {status}"
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[97m●  \u001b[94m●  \u001b[95m●  \u001b[96m●  \u001b[90m●\u001b[0m"
    },
    "break"
  ]
}
