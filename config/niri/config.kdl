// DarkShadow's Shell: generated by rice-niri. Do not edit: your changes go in user.kdl.
// Change it from the Settings app (SUPER + U) or run: rice-niri apply
// niri 26.4

input {
    keyboard {
        xkb {
        }
        numlock
    }
    mouse {
        accel-speed 0.0
    }
    touchpad {
        accel-speed 0.0
        tap
        natural-scroll
        dwt
    }
    focus-follows-mouse max-scroll-amount="0%"
    warp-mouse-to-focus
}

output "eDP-1" {
    scale 1.0
}

layout {
    gaps 12
    center-focused-column "never"
    always-center-single-column
    background-color "transparent"
    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
        proportion 1.0
    }
    default-column-width {
        proportion 0.5
    }
    focus-ring {
        off
    }
    border {
        width 1
        active-gradient from="#b2c5ff" to="#e1bbdc" angle=45 relative-to="workspace-view"
        inactive-color "#59595980"
        urgent-color "#ff8a80"
    }
    shadow {
        on
        softness 24
        spread 4
        offset x=0 y=4
        color "#00000099"
    }
    struts {
        left 2
        right 2
        top 2
        bottom 2
    }
}

prefer-no-csd
screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"
hotkey-overlay {
    skip-at-startup
    hide-not-bound
}
cursor {
    xcursor-theme "Bibata-Modern-Ice"
    xcursor-size 24
    hide-when-typing
}
environment {
    ELECTRON_OZONE_PLATFORM_HINT "auto"
    QT_QPA_PLATFORM "wayland;xcb"
    QT_WAYLAND_DISABLE_WINDOWDECORATION "1"
    MOZ_ENABLE_WAYLAND "1"
    XDG_CURRENT_DESKTOP "niri"
    XDG_SESSION_TYPE "wayland"
}
overview {
    zoom 0.5
    backdrop-color "#101114"
    workspace-shadow {
        softness 40
        spread 10
        offset x=0 y=10
        color "#00000050"
    }
}
gestures {
    hot-corners {
        top-left
    }
}
blur {
    passes 3
    offset 2.67
    noise 0.0
    saturation 1.0
}

spawn-sh-at-startup "/home/ghozty/.local/bin/rice-niri apply"
spawn-sh-at-startup "systemctl --user import-environment WAYLAND_DISPLAY XDG_CURRENT_DESKTOP NIRI_SOCKET DISPLAY 2>/dev/null; dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP NIRI_SOCKET DISPLAY 2>/dev/null"
spawn-sh-at-startup "/home/ghozty/.local/bin/rice-sys session"
spawn-sh-at-startup "/home/ghozty/.local/bin/rice-walls awww"
spawn-sh-at-startup "/home/ghozty/.local/bin/rice-notifyd"
spawn-sh-at-startup "hypridle"
spawn-sh-at-startup "/home/ghozty/.local/bin/rice-bar start"
spawn-sh-at-startup "/home/ghozty/.local/bin/rice-desktop start"
spawn-sh-at-startup "/home/ghozty/.local/bin/rice-cursor restore"
spawn-sh-at-startup "/home/ghozty/.local/bin/rice-infinite daemon"
spawn-sh-at-startup "systemctl --user start hyprpolkitagent.service 2>/dev/null || { for a in /usr/lib/hyprpolkitagent/hyprpolkitagent /usr/libexec/hyprpolkitagent /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1 /usr/libexec/polkit-gnome-authentication-agent-1 /usr/lib/polkit-kde-authentication-agent-1; do [ -x \"$a\" ] && exec \"$a\"; done; command -v hyprpolkitagent >/dev/null && exec hyprpolkitagent; }"

animations {
    workspace-switch {
        spring damping-ratio=1.0 stiffness=700 epsilon=0.0001
    }
    window-open {
        duration-ms 320
        curve "cubic-bezier" 0.05 0.7 0.1 1.0
    }
    window-close {
        duration-ms 200
        curve "cubic-bezier" 0.3 0.0 0.8 0.15
    }
    horizontal-view-movement {
        spring damping-ratio=1.0 stiffness=700 epsilon=0.0001
    }
    window-movement {
        spring damping-ratio=1.0 stiffness=700 epsilon=0.0001
    }
    window-resize {
        spring damping-ratio=1.0 stiffness=700 epsilon=0.0001
    }
    overview-open-close {
        spring damping-ratio=1.0 stiffness=700 epsilon=0.0001
    }
}

window-rule {
    geometry-corner-radius 22
    clip-to-geometry true
    draw-border-with-background false
}
window-rule {
    match app-id="^org\\.gnome\\.Nautilus$"
    opacity 0.92
    background-effect {
        blur true
    }
}
window-rule {
    match app-id="^(kitty|foot|footclient|Alacritty|com\\.mitchellh\\.ghostty|org\\.wezfurlong\\.wezterm)$"
    background-effect {
        blur true
    }
}
window-rule {
    match title="^Rice Settings$"
    background-effect {
        blur true
        xray false
    }
}
window-rule {
    match title="^Rice Settings$"
    open-floating true
}
window-rule {
    match app-id="^org\\.pulseaudio\\.pavucontrol$"
    open-floating true
    default-column-width {
        fixed 900
    }
    default-window-height { fixed 650; }
}
window-rule {
    match app-id="^io\\.github\\.kaii_lb\\.Overskride$"
    open-floating true
    default-column-width {
        fixed 900
    }
    default-window-height { fixed 650; }
}
window-rule {
    match app-id="^waypaper$"
    open-floating true
    default-column-width {
        fixed 900
    }
    default-window-height { fixed 650; }
}
window-rule {
    match app-id="^gsimplecal$"
    open-floating true
}
window-rule {
    match app-id="^nmtui$"
    open-floating true
    default-column-width {
        fixed 800
    }
    default-window-height { fixed 500; }
}
window-rule {
    match app-id="[Zz]enity"
    open-floating true
}
window-rule {
    match app-id="^org\\.gnome\\.Calendar$"
    open-floating true
    default-column-width {
        fixed 900
    }
    default-window-height { fixed 650; }
}
window-rule {
    match app-id="^hyprland-run$"
    open-floating true
}
window-rule {
    match app-id="^xdg-desktop-portal"
    open-floating true
}
window-rule {
    match title="^Picture.in.[Pp]icture$"
    open-floating true
}
window-rule {
    match title="^Picture.in.[Pp]icture$"
    default-floating-position x=32 y=32 relative-to="bottom-right"
}

layer-rule {
    match namespace="^rice-backdrop$"
    place-within-backdrop true
}
layer-rule {
    match namespace="^rice-(welcome|tour-dim)$"
    shadow { off; }
}
layer-rule {
    match namespace="^rice-(bar|bluetooth|cc|clipboard|deskmenu|dock|dock-apps|gamebar|hotcorner|launcher|notify-popup|power|volume|osd|taskview|wallum|walls|wifi)$"
    background-effect {
        xray false
    }
}

binds {
    Mod+Return hotkey-overlay-title="Terminal" { spawn "/home/ghozty/.local/bin/rice-term"; }
    Mod+E hotkey-overlay-title="Files" { spawn "nautilus"; }
    Mod+D hotkey-overlay-title="Launcher" { spawn "/home/ghozty/.local/bin/rice-launch"; }
    Alt+Space hotkey-overlay-title=null { spawn "/home/ghozty/.local/bin/rice-launch"; }
    Mod+U hotkey-overlay-title="Settings" { spawn "/home/ghozty/.local/bin/rice-settings"; }
    Mod+L hotkey-overlay-title="Lock the screen" { spawn "/home/ghozty/.local/bin/rice-lock" "now"; }
    Mod+W hotkey-overlay-title="Wallpapers" { spawn "/home/ghozty/.local/bin/rice-dashboard" "wallpaper"; }
    Mod+N hotkey-overlay-title="Control center" { spawn "/home/ghozty/.local/bin/rice-cc"; }
    Mod+A hotkey-overlay-title="Quick switches" { spawn "/home/ghozty/.local/bin/rice-dashboard" "open" "control"; }
    Mod+G hotkey-overlay-title="Game bar" { spawn "/home/ghozty/.local/bin/rice-gamebar"; }
    Mod+Alt+W hotkey-overlay-title="Edit the desktop widgets" { spawn "/home/ghozty/.local/bin/desktop-set" "edit" "toggle"; }
    Mod+Alt+D hotkey-overlay-title=null { spawn "/home/ghozty/.local/bin/rice-dashboard" "open"; }
    Print hotkey-overlay-title="Screenshot of an area" { spawn "/home/ghozty/.local/bin/rice-hotcorner" "shot" "region"; }
    Shift+Print hotkey-overlay-title="Screenshot of the screen" { spawn "/home/ghozty/.local/bin/rice-hotcorner" "shot" "full"; }
    Mod+Shift+S hotkey-overlay-title=null { spawn "/home/ghozty/.local/bin/screenshot"; }
    Ctrl+Print { screenshot-screen; }
    Alt+Print { screenshot-window; }
    Mod+Shift+R hotkey-overlay-title="Record the screen (again: stop)" { spawn "/home/ghozty/.local/bin/rice-hotcorner" "record" "region"; }
    Mod+Q repeat=false hotkey-overlay-title="Close the window" { close-window; }
    Mod+C repeat=false { close-window; }
    Mod+V repeat=false hotkey-overlay-title="Clipboard" { spawn "/home/ghozty/.local/bin/rice-clip" "toggle"; }
    Mod+Shift+V hotkey-overlay-title="Float / tile the window" { toggle-window-floating; }
    Mod+Ctrl+V { switch-focus-between-floating-and-tiling; }
    Mod+F hotkey-overlay-title="Maximize the column" { maximize-column; }
    Mod+Shift+F hotkey-overlay-title="Fullscreen" { fullscreen-window; }
    Mod+Ctrl+F { expand-column-to-available-width; }
    Mod+M { maximize-window-to-edges; }
    Mod+Shift+C { center-column; }
    Mod+T hotkey-overlay-title="Tabs in this column" { toggle-column-tabbed-display; }
    Mod+R { switch-preset-column-width; }
    Mod+Ctrl+R { reset-window-height; }
    Mod+Minus { set-column-width "-10%"; }
    Mod+Equal { set-column-width "+10%"; }
    Mod+Shift+Minus { set-window-height "-10%"; }
    Mod+Shift+Equal { set-window-height "+10%"; }
    Mod+BracketLeft { consume-or-expel-window-left; }
    Mod+BracketRight { consume-or-expel-window-right; }
    Mod+Comma { consume-window-into-column; }
    Mod+Period { expel-window-from-column; }
    Mod+Left { focus-column-left; }
    Mod+Right { focus-column-right; }
    Mod+Up { focus-window-or-workspace-up; }
    Mod+Down { focus-window-or-workspace-down; }
    Mod+Ctrl+Left { move-column-left; }
    Mod+Ctrl+Right { move-column-right; }
    Mod+Ctrl+Up { move-window-up-or-to-workspace-up; }
    Mod+Ctrl+Down { move-window-down-or-to-workspace-down; }
    Mod+Shift+Left { focus-monitor-left; }
    Mod+Shift+Right { focus-monitor-right; }
    Mod+Shift+Up { focus-monitor-up; }
    Mod+Shift+Down { focus-monitor-down; }
    Mod+Shift+Ctrl+Left { move-column-to-monitor-left; }
    Mod+Shift+Ctrl+Right { move-column-to-monitor-right; }
    Mod+Home { focus-column-first; }
    Mod+End { focus-column-last; }
    Mod+Page_Down { focus-workspace-down; }
    Mod+Page_Up { focus-workspace-up; }
    Mod+Ctrl+Page_Down { move-column-to-workspace-down; }
    Mod+Ctrl+Page_Up { move-column-to-workspace-up; }
    Mod+WheelScrollDown cooldown-ms=150 { focus-workspace-down; }
    Mod+WheelScrollUp cooldown-ms=150 { focus-workspace-up; }
    Mod+WheelScrollRight { focus-column-right; }
    Mod+WheelScrollLeft { focus-column-left; }
    Mod+Shift+WheelScrollDown { focus-column-right; }
    Mod+Shift+WheelScrollUp { focus-column-left; }
    Mod+Tab repeat=false hotkey-overlay-title="Task view" { spawn "/home/ghozty/.local/bin/rice-taskview" "overview"; }
    Alt+Tab hotkey-overlay-title="Switch windows" { spawn "/home/ghozty/.local/bin/rice-taskview" "switch"; }
    Alt+Shift+Tab hotkey-overlay-title=null { spawn "/home/ghozty/.local/bin/rice-taskview" "back"; }
    Mod+O repeat=false hotkey-overlay-title="niri overview" { toggle-overview; }
    Mod+Shift+Slash hotkey-overlay-title="These keys" { show-hotkey-overlay; }
    Mod+Escape allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }
    Mod+Shift+P { power-off-monitors; }
    Mod+Shift+E hotkey-overlay-title="Log out" { quit; }
    Ctrl+Alt+Delete { quit; }
    XF86AudioRaiseVolume allow-when-locked=true { spawn "/home/ghozty/.local/bin/rice-media" "up"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn "/home/ghozty/.local/bin/rice-media" "down"; }
    XF86AudioMute allow-when-locked=true { spawn "/home/ghozty/.local/bin/rice-media" "mute"; }
    XF86AudioMicMute allow-when-locked=true { spawn "/home/ghozty/.local/bin/rice-media" "mic"; }
    XF86MonBrightnessUp allow-when-locked=true { spawn "/home/ghozty/.local/bin/rice-media" "bright-up"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "/home/ghozty/.local/bin/rice-media" "bright-down"; }
    XF86AudioPlay allow-when-locked=true { spawn "playerctl" "play-pause"; }
    XF86AudioPause allow-when-locked=true { spawn "playerctl" "play-pause"; }
    XF86AudioNext allow-when-locked=true { spawn "playerctl" "next"; }
    XF86AudioPrev allow-when-locked=true { spawn "playerctl" "previous"; }
    Alt+BracketRight { spawn "/home/ghozty/.local/bin/rice-volume" "up"; }
    Alt+BracketLeft { spawn "/home/ghozty/.local/bin/rice-volume" "down"; }
    Mod+F12 { spawn "/home/ghozty/.local/bin/rice-volume" "up"; }
    Mod+F11 { spawn "/home/ghozty/.local/bin/rice-volume" "down"; }
    Mod+F10 { spawn "/home/ghozty/.local/bin/rice-volume" "mute"; }
    Mod+1 { focus-workspace 1; }
    Mod+Shift+1 { move-window-to-workspace 1; }
    Mod+Ctrl+1 { move-column-to-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+Shift+2 { move-window-to-workspace 2; }
    Mod+Ctrl+2 { move-column-to-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+Shift+3 { move-window-to-workspace 3; }
    Mod+Ctrl+3 { move-column-to-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+Shift+4 { move-window-to-workspace 4; }
    Mod+Ctrl+4 { move-column-to-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+Shift+5 { move-window-to-workspace 5; }
    Mod+Ctrl+5 { move-column-to-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+Shift+6 { move-window-to-workspace 6; }
    Mod+Ctrl+6 { move-column-to-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+Shift+7 { move-window-to-workspace 7; }
    Mod+Ctrl+7 { move-column-to-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+Shift+8 { move-window-to-workspace 8; }
    Mod+Ctrl+8 { move-column-to-workspace 8; }
    Mod+9 { focus-workspace 9; }
    Mod+Shift+9 { move-window-to-workspace 9; }
    Mod+Ctrl+9 { move-column-to-workspace 9; }
    Mod+0 { focus-workspace 10; }
    Mod+Shift+0 { move-window-to-workspace 10; }
    Mod+Ctrl+0 { move-column-to-workspace 10; }
}

recent-windows {
    off
}

// your own settings (loaded last, so they win)
include optional=true "user.kdl"
